<div class="page-header">
  <h1>Forgot your password?</h1>
</div>

<div class="form-card">
  <%= form_with url: password_resets_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>

    <%= f.submit "Send reset link", class: "btn btn--primary" %>
  <% end %>
</div>
