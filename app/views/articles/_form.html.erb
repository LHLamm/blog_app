<div class="form-card"
     <% if article.persisted? %>
       data-controller="autosave"
       data-autosave-url-value="<%= autosave_article_path(article) %>"
     <% end %>>
  <%= form_with model: article, local: true, multipart: true do |f| %>
    <% if article.errors.any? %>
      <div class="error-summary">
        <strong><%= pluralize(article.errors.count, "error") %> prevented this article from being saved:</strong>
        <ul>
          <% article.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Title" %>
      <%= f.text_field :title, data: (article.persisted? ? { autosave_target: "field", action: "input->autosave#schedule" } : {}) %>
    </div>

    <div class="form-group">
      <%= f.label :body, "Body" %>
      <%= f.text_area :body, rows: 8, data: (article.persisted? ? { autosave_target: "field", action: "input->autosave#schedule" } : {}) %>
    </div>

    <div class="form-group">
      <%= f.label :cover_image, "Cover image" %>
      <%= f.file_field :cover_image, accept: "image/*" %>
      <% if article.cover_image.attached? %>
        <p class="form-hint">Current: <%= article.cover_image.filename %></p>
      <% end %>
    </div>

    <% if article.persisted? %>
      <p class="form-hint" data-autosave-target="status"></p>
    <% end %>

    <%= f.submit submit_label, class: "btn btn--primary" %>
  <% end %>
</div>
