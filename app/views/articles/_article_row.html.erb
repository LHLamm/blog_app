<div id="<%= dom_id(article) %>" class="article-row">
  <span class="article-row__title"><%= link_to article.title, article_path(article) %></span>
  <span class="article-row__author">by <%= article.author.name %></span>
  <span class="article-row__status article-row__status--<%= article.status %>"><%= article.status %></span>
  <span class="article-row__time"><%= article.created_at.strftime("%H:%M:%S") %></span>
  <%= button_to "Delete", article_path(article), method: :delete, class: "btn btn--danger article-row__delete", data: { turbo_confirm: "Delete \"#{article.title}\"? This cannot be undone." } %>
</div>
