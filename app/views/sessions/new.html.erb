<div class="page-header">
  <h1>Log In</h1>
</div>

<div class="form-card">
  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password %>
    </div>

    <%= f.submit "Log in", class: "btn btn--primary" %>
  <% end %>

  <p style="margin-top: 14px; font-size: 0.85rem;">
    <%= link_to "Forgot your password?", new_password_reset_path %>
  </p>
  <p style="margin-top: 6px; font-size: 0.85rem;">
    Don't have an account? <%= link_to "Sign up", new_registration_path %>
  </p>
</div>
