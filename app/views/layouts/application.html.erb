<!DOCTYPE html>
<html>
  <head>
    <title>BlogApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>

  <body>
    <header class="navbar">
      <div class="navbar__inner">
        <%= link_to "BlogApp", root_path, class: "navbar__brand" %>
        <nav class="navbar__links">
          <%= link_to "Articles", articles_path %>

          <% if logged_in? %>
            <%= link_to "New article", new_article_path %>
            <%= link_to current_user.name, user_path(current_user) %>
            <%= button_to "Log out", logout_path, method: :delete, class: "btn btn--ghost" %>
          <% else %>
            <%= link_to "Log in", login_path %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn--primary" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <div class="flash flash--notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash flash--alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
